# Copy this file to `.env` and fill in your own keys.
# NEVER commit the real .env file to version control.

# Apify — get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Exa — get your key at https://dashboard.exa.ai/
EXA_API_KEY=your_exa_key_here

# Tavily (optional fallback news source) — https://app.tavily.com/
TAVILY_API_KEY=your_tavily_key_here

# Optional overrides (defaults shown)
# SENTIMENT_MODEL=ProsusAI/finbert
# RETRY_MAX_ATTEMPTS=3
# RETRY_BACKOFF_BASE=2.0
# REQUEST_TIMEOUT=60
